# Supabase (optional — enables hosted DB/auth/storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local admin auth fallback when Supabase Auth is not configured
AUTH_SECRET=dev-motive-index-secret-change-me
ADMIN_EMAIL=admin@motiveindex.local
ADMIN_PASSWORD=motive-admin

# Optional: enables LLM-backed extraction + analysis via OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
