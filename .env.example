# Optional: public site URL for sitemap/OG (defaults to VERCEL_URL or localhost)
NEXT_PUBLIC_SITE_URL=

# Supabase (optional — enables hosted DB/auth/storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local admin auth fallback when Supabase Auth is not configured
AUTH_SECRET=dev-motive-index-secret-change-me
ADMIN_EMAIL=admin@motiveindex.local
ADMIN_PASSWORD=motive-admin

# Live-update worker
CRON_SECRET=
LIVE_UPDATE_LIMIT=8
# Comma-separated RSS URLs (optional override)
LIVE_UPDATE_FEEDS=

# Optional: LLM extraction + analysis (OpenAI or OpenRouter)
OPENAI_API_KEY=
# OpenRouter example: https://openrouter.ai/api/v1  (leave unset for api.openai.com)
OPENAI_BASE_URL=
# OpenAI: gpt-4o-mini | OpenRouter: openai/gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
