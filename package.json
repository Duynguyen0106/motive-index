{
  "name": "motive-index",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "verify": "bash scripts/verify-phase1.sh http://localhost:3000",
    "validate:catalog": "node scripts/validate-catalog.mjs",
    "validate:references": "npx tsx scripts/validate-reference-accuracy.mjs && npx tsx scripts/audit-reference-links.mjs",
    "validate:defs": "npx tsx scripts/validate-case-defs.mjs",
    "validate:all-cases": "npx tsx scripts/audit-all-cases.mjs",
    "db:sync": "node --env-file=.env.local scripts/db-sync.mjs",
    "db:reseed": "node scripts/reseed-store.mjs",
    "db:generate-bulk": "node scripts/generate-bulk-cases.mjs",
    "live-update": "curl -s -X POST http://localhost:3000/api/cron/live-update -H 'content-type: application/json' -d '{\"limit\":5}'"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@types/leaflet.markercluster": "^1.5.6",
    "jose": "^6.2.10",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
